/**index.wxss**/
/* 颜色跟 web/style.css 对齐，同一个角色同一个值，两边看着是一套东西。
   定义在 page 上，子节点都能继承到。
   四个状态色已经先放这儿了 —— 结果徽章暂时还是中性色，
   要按 status 上色时直接引用，不用再翻网页那套变量。 */
page {
  --page:           #f9f9f7;
  --surface-1:      #fcfcfb;
  --text-primary:   #0b0b0b;
  --text-secondary: #52514e;
  --text-muted:     #898781;
  --hairline:       #e1e0d9;

  --status-good:     #0ca30c;  /* 正常 */
  --status-warning:  #fab219;  /* 偏冷 */
  --status-serious:  #ec835a;  /* 偏湿 */
  --status-critical: #d03b3b;  /* 偏热 */

  min-height: 100vh;
  background: var(--page);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 48rpx 32rpx 64rpx;
}

.app-title {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.2;
}

.app-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}

.card {
  margin-top: 48rpx;
  padding: 0 32rpx;
  background: var(--surface-1);
  border: 1rpx solid var(--hairline);
  border-radius: 24rpx;
}

/* ---------- 录入区 ---------- */

/* 输入行也是「左标签 右输入」，和结果行同一套排版 */
.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}

.field--last {
  border-bottom: none;
}

.input {
  flex: 1;
  height: 56rpx;
  margin-left: 24rpx;
  font-size: 32rpx;
  text-align: right;
  color: var(--text-primary);
}

/* placeholder 单独用 class 才能改样式，placeholder-style 只能写行内 */
.ph {
  color: var(--text-muted);
  font-size: 30rpx;
}

/* 按钮默认是微信灰底 + ::after 画的描边，两样都要盖掉 */
.analyze {
  margin: 8rpx 0 36rpx;
  padding: 0;
  background: var(--text-primary);
  color: var(--surface-1);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 92rpx;
  border-radius: 16rpx;
}

.analyze::after {
  border: none;
}

/* 按下时压一点，给个触感反馈。
   background/color 必须一起重写：微信默认的 .button-hover 会把文字改成
   半透明黑，白字压在黑底按钮上会直接看不见。 */
.analyze.button-hover {
  background: var(--text-primary);
  color: var(--surface-1);
  opacity: 0.85;
}

/* ---------- 错误提示 ---------- */

.error {
  margin-top: 24rpx;
  padding: 20rpx 28rpx;
  background: rgba(208, 59, 59, 0.08);
  border-left: 6rpx solid var(--status-critical);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--status-critical);
}

/* ---------- 结果区 ---------- */

.result {
  margin-top: 32rpx;
}

/* 每行「标签 …… 值」，最后一行不画分隔线 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}

.row--last {
  border-bottom: none;
}

.label {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.value {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
}

/* 数字大、单位小，单位跟数字基线对齐 */
.num {
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1;
}

.unit {
  margin-left: 6rpx;
  font-size: 28rpx;
  color: var(--text-muted);
}

.badge {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #ecebe4;
  font-size: 30rpx;
  line-height: 1.4;
}

.advice {
  max-width: 440rpx;
  font-size: 30rpx;
  text-align: right;
}
